{
    "name": "t11n-dev/flarum-migration-tool",
    "description": "Complete migration tool with admin UI for easy Flarum server transfer. Backup, restore, and migrate your forum with just a few clicks.",
    "type": "flarum-extension",
    "keywords": [
        "flarum",
        "extension",
        "migration",
        "backup",
        "restore",
        "transfer",
        "server migration",
        "admin ui"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "T11N",
            "email": "me@t11n.dev",
            "homepage": "https://t11n.dev/"
        }
    ],
    "support": {
        "issues": "https://github.com/t11n-dev/Flarum-Migration-Tool/issues",
        "source": "https://github.com/t11n-dev/Flarum-Migration-Tool",
        "forum": "https://discuss.flarum.org/d/your-discussion-id"
    },
    "homepage": "https://github.com/t11n-dev/Flarum-Migration-Tool",
    "require": {
        "php": ">=8.0",
        "ext-zip": "*",
        "flarum/core": "^1.0"
    },
    "require-dev": {
        "flarum/testing": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "T11N\\MigrationTool\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "T11N\\MigrationTool\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Migration Tool",
            "category": "administration",
            "icon": {
                "name": "fas fa-exchange-alt",
                "backgroundColor": "#3498db",
                "color": "#fff"
            }
        },
        "flagrow": {
            "discuss": "https://discuss.flarum.org/d/your-discussion-id"
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
